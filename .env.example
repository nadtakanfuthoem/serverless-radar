# AWS profile to use for deployment
AWS_PROFILE=your-profile-name

# AWS account ID (needed for CDK context lookups)
AWS_ACCOUNT_ID=123456789012

# Domain configuration
DOMAIN_NAME=example.com
SUBDOMAIN=serverless-radar.example.com

# Email for SNS notifications
NOTIFICATION_EMAIL=your-email@example.com
# dev.to API key — do NOT put it here.
# The weekly summary Lambda reads it from AWS Secrets Manager.
# After `cdk deploy`, populate the secret (created empty by the stack):
#   aws secretsmanager put-secret-value \
#     --secret-id serverless-radar/devto-api-key \
#     --secret-string '{"apiKey":"YOUR_DEVTO_API_KEY"}'
# A raw key string also works. Generate a key at https://dev.to/settings/extensions
